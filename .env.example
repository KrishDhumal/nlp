# ═══════════════════════════════════════════════════════
#  AUDITOR AI — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# Run: copy .env.example .env (Windows) or cp .env.example .env (Mac/Linux)

# ── Authentication ──
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256

# ── MongoDB ──
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=legal_document_summarizer

# ── Google Gemini AI (Free Tier) ──
# Get your key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# ── Pinecone Vector Database ──
# Sign up: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=legal-docs
PINECONE_HOST=your-pinecone-host-url

# ── Redis / Upstash (Optional — app works without it) ──
# For Upstash: https://upstash.com/ (free tier available)
# Format: redis://default:password@host:port
# REDIS_URL=redis://default:your-password@your-host.upstash.io:6379

# ── File Uploads ──
UPLOADS_DIR=uploads

# ── Google OAuth (for "Continue with Google" button) ──
# Create a project at: https://console.cloud.google.com/
# Enable the "Google Identity Services" API
# Go to APIs & Services > Credentials > Create OAuth 2.0 Client ID
# Application type: Web application
# Authorized JavaScript origins: http://localhost:5173 (dev), https://yourdomain.com (prod)
# The Client ID goes in BOTH backend and frontend env files:
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Frontend-specific — copy to frontend/.env.local ──
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Token-aware chunking (replaces character-based splitting) ──
# Tokens are the primary constraint; these feed the summarisation model's window.
CHUNK_MAX_TOKENS=768
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=32

# ── Summarisation ──
# "local" runs a Hugging Face model in-process and needs NO API key (default).
# "gemini" uses the Google API instead — optional, rate limited.
SUMMARY_PROVIDER=local
# Must be fine-tuned for summarisation of documents like these. Known-bad:
#   allenai/led-base-16384      - only pretrained, echoes its input
#   nsi319/legal-led-base-16384 - trained on SEC litigation releases, fabricates
SUMMARIZATION_MODEL=Falconsai/text_summarization
# Tried in order if the model above cannot be loaded (stalled download, etc.)
SUMMARIZATION_FALLBACK_MODELS=sshleifer/distilbart-cnn-12-6
# Give up on loading a model after this many seconds and degrade to extracts.
SUMMARIZATION_LOAD_TIMEOUT=300
# Minimum share of a summary's content words that must appear in its source.
SUMMARY_MIN_GROUNDING=0.6
# auto -> cuda, then mps (Apple Silicon), then cpu
SUMMARIZATION_DEVICE=auto
SUMMARIZATION_MAX_INPUT_TOKENS=4096
SUMMARIZATION_MAX_OUTPUT_TOKENS=256
SUMMARIZATION_BATCH_SIZE=2
# Set true only for an instruction-following checkpoint.
SUMMARIZATION_USE_INSTRUCTION=false
# Chunks per group in the intermediate reduce stage.
SUMMARY_GROUP_SIZE=5
# Documents with fewer chunks than this skip the intermediate reduce level.
SUMMARY_HIERARCHY_THRESHOLD=8

# ── Upload limits ──
MAX_UPLOAD_MB=20
# A PDF yielding less text than this is reported as needing OCR.
MIN_TEXT_CHARS=200
